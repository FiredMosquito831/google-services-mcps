{
  "name": "google-services-mcps",
  "version": "0.1.0",
  "description": "MCP servers for Google Cloud console, Google Workspace (user data and admin), and Google Search Console, packaged as a Claude Code plugin and installable into Codex, OpenCode and Antigravity (agy).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && node --test \"tests/*.test.mjs\"",
    "build": "node scripts/bundle.mjs",
    "compile": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@googleapis/admin": "^37.0.2",
    "@googleapis/apikeys": "^13.0.1",
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/cloudresourcemanager": "^11.1.0",
    "@googleapis/drive": "^26.0.2",
    "@googleapis/gmail": "^22.0.1",
    "@googleapis/searchconsole": "^11.0.1",
    "@googleapis/serviceusage": "^29.0.0",
    "@googleapis/webmasters": "^9.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "google-auth-library": "^11.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
