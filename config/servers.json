{
  "$comment": "Single source of truth for the MCP suite. Each plugin is one category. Each server is one MCP process. kind=curated uses hand-written tools; kind=discovery generates tools from Google's Discovery documents; curated+discovery does both in one server. group = auth group, one login per group.",
  "plugins": {
    "google-cloud": "Google Cloud console: projects, APIs, keys, dashboards, data, compute",
    "google-workspace": "Google Workspace: Gmail, Drive, Calendar, Docs, Sheets, Slides, Forms, Tasks, People, Chat, Apps Script, Meet, admin",
    "google-search": "Google Search: Search Console sites, sitemaps, analytics, URL inspection, Custom Search, site verification, Indexing API",
    "google-business": "Google Business: Analytics, Tag Manager, YouTube, Business Profile"
  },
  "groups": {
    "cloud": "Application Default Credentials or OAuth user token with cloud-platform scope",
    "workspace-user": "OAuth user token (Gmail, Drive, Calendar and the user-data APIs)",
    "workspace-admin": "Service account with domain-wide delegation, impersonating a super admin",
    "searchconsole": "OAuth user token with webmasters scope",
    "business": "OAuth user token with the scopes of the business APIs"
  },
  "servers": [
    {
      "name": "gcloud",
      "plugin": "google-cloud",
      "group": "cloud",
      "kind": "curated",
      "curated": "src/servers/cloud.ts",
      "label": "Cloud console core: projects, enable/disable APIs, API keys, IAM policy, operations",
      "scopes": [
        "https://www.googleapis.com/auth/cloud-platform"
      ]
    },
    {
      "name": "gcloud-ops",
      "plugin": "google-cloud",
      "group": "cloud",
      "kind": "discovery",
      "apis": [
        {
          "api": "monitoring",
          "version": "v3"
        },
        {
          "api": "logging",
          "version": "v2"
        },
        {
          "api": "cloudtrace",
          "version": "v2"
        },
        {
          "api": "clouderrorreporting",
          "version": "v1beta1"
        },
        {
          "api": "cloudbilling",
          "version": "v1"
        },
        {
          "api": "cloudquotas",
          "version": "v1"
        },
        {
          "api": "cloudasset",
          "version": "v1"
        }
      ],
      "label": "Cloud dashboards: monitoring, logging, trace, error reporting, billing, quotas, asset inventory"
    },
    {
      "name": "gcloud-data",
      "plugin": "google-cloud",
      "group": "cloud",
      "kind": "discovery",
      "apis": [
        {
          "api": "bigquery",
          "version": "v2"
        },
        {
          "api": "storage",
          "version": "v1"
        },
        {
          "api": "firestore",
          "version": "v1"
        },
        {
          "api": "spanner",
          "version": "v1"
        },
        {
          "api": "sqladmin",
          "version": "v1"
        },
        {
          "api": "pubsub",
          "version": "v1"
        },
        {
          "api": "run",
          "version": "v2"
        },
        {
          "api": "cloudfunctions",
          "version": "v2"
        },
        {
          "api": "secretmanager",
          "version": "v1"
        },
        {
          "api": "cloudkms",
          "version": "v1"
        },
        {
          "api": "artifactregistry",
          "version": "v1"
        },
        {
          "api": "container",
          "version": "v1"
        }
      ],
      "label": "Cloud data and runtimes: BigQuery, Cloud Storage, Firestore, Spanner, Cloud SQL, Pub/Sub, Cloud Run, Functions, Secrets, KMS, Artifact Registry, GKE"
    },
    {
      "name": "gcloud-compute",
      "plugin": "google-cloud",
      "group": "cloud",
      "kind": "discovery",
      "apis": [
        {
          "api": "compute",
          "version": "v1"
        }
      ],
      "label": "Compute Engine: instances, disks, networks, firewalls, load balancers (large surface)"
    },
    {
      "name": "gws-user",
      "plugin": "google-workspace",
      "group": "workspace-user",
      "kind": "curated+discovery",
      "curated": "src/servers/workspace-user.ts",
      "apis": [
        {
          "api": "docs",
          "version": "v1"
        },
        {
          "api": "sheets",
          "version": "v4"
        },
        {
          "api": "slides",
          "version": "v1"
        },
        {
          "api": "forms",
          "version": "v1"
        },
        {
          "api": "tasks",
          "version": "v1"
        },
        {
          "api": "people",
          "version": "v1"
        },
        {
          "api": "chat",
          "version": "v1"
        },
        {
          "api": "script",
          "version": "v1"
        },
        {
          "api": "meet",
          "version": "v2"
        }
      ],
      "label": "Workspace user data: Gmail, Drive, Calendar (curated) plus Docs, Sheets, Slides, Forms, Tasks, People, Chat, Apps Script, Meet",
      "scopes": [
        "https://www.googleapis.com/auth/gmail.readonly",
        "https://www.googleapis.com/auth/gmail.compose",
        "https://www.googleapis.com/auth/drive",
        "https://www.googleapis.com/auth/calendar.readonly",
        "https://www.googleapis.com/auth/calendar.events"
      ]
    },
    {
      "name": "gws-admin",
      "plugin": "google-workspace",
      "group": "workspace-admin",
      "kind": "curated+discovery",
      "curated": "src/servers/workspace-admin.ts",
      "apis": [
        {
          "api": "reports",
          "version": "v1"
        },
        {
          "api": "licensing",
          "version": "v1"
        },
        {
          "api": "groupssettings",
          "version": "v1"
        },
        {
          "api": "alertcenter",
          "version": "v1beta1"
        },
        {
          "api": "datatransfer",
          "version": "v1"
        },
        {
          "api": "vault",
          "version": "v1"
        },
        {
          "api": "cloudidentity",
          "version": "v1"
        }
      ],
      "label": "Workspace admin: users, org units, groups (curated) plus reports, licensing, group settings, alerts, data transfer, Vault, Cloud Identity",
      "scopes": [
        "https://www.googleapis.com/auth/admin.directory.user",
        "https://www.googleapis.com/auth/admin.directory.group",
        "https://www.googleapis.com/auth/admin.directory.orgunit"
      ]
    },
    {
      "name": "gsc",
      "plugin": "google-search",
      "group": "searchconsole",
      "kind": "curated+discovery",
      "curated": "src/servers/searchconsole.ts",
      "apis": [
        {
          "api": "customsearch",
          "version": "v1"
        },
        {
          "api": "siteVerification",
          "version": "v1"
        },
        {
          "api": "indexing",
          "version": "v3"
        }
      ],
      "label": "Search Console: sites, sitemaps, analytics, URL inspection (curated) plus Custom Search, site verification, Indexing API (restricted use)",
      "scopes": [
        "https://www.googleapis.com/auth/webmasters"
      ]
    },
    {
      "name": "gbiz",
      "plugin": "google-business",
      "group": "business",
      "kind": "discovery",
      "apis": [
        {
          "api": "analyticsadmin",
          "version": "v1beta"
        },
        {
          "api": "analyticsdata",
          "version": "v1beta"
        },
        {
          "api": "tagmanager",
          "version": "v2"
        },
        {
          "api": "youtube",
          "version": "v3"
        },
        {
          "api": "youtubeAnalytics",
          "version": "v2"
        },
        {
          "api": "mybusinessaccountmanagement",
          "version": "v1"
        },
        {
          "api": "mybusinessbusinessinformation",
          "version": "v1"
        },
        {
          "api": "mybusinessverifications",
          "version": "v1"
        },
        {
          "api": "businessprofileperformance",
          "version": "v1"
        },
        {
          "api": "mybusinessnotifications",
          "version": "v1"
        }
      ],
      "label": "Business: Google Analytics admin and data, Tag Manager, YouTube, Business Profile"
    }
  ]
}
