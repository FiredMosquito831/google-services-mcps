{
  "mcpServers": {
    "gchat": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/servers/gchat.mjs"
      ],
      "env": {
        "GSM_ALLOW_WRITES": "${user_config.allow_writes}",
        "GSM_CONFIRMATION": "${user_config.confirmation}",
        "GSM_TOKEN_DIR": "${user_config.token_dir}",
        "GSM_HOOK_ACTIVE": "1",
        "GSM_TOOLSET": "${user_config.toolset}"
      }
    }
  }
}
