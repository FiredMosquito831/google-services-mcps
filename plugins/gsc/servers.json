{
  "$comment": "Generated by scripts/bundle.mjs for the gsc plugin. Do not edit.",
  "plugins": {
    "gsc": "Search Console sites, sitemaps, search analytics, URL indexing and site verification."
  },
  "groups": {
    "searchconsole": "OAuth user token with the webmasters scope"
  },
  "servers": [
    {
      "name": "gsc",
      "plugin": "gsc",
      "group": "searchconsole",
      "kind": "curated+discovery",
      "curated": "src/servers/searchconsole.ts",
      "apis": [
        {
          "api": "searchconsole",
          "version": "v1",
          "include": [
            "sites",
            "sitemaps",
            "searchanalytics",
            "urlInspection.index"
          ]
        },
        {
          "api": "siteVerification",
          "version": "v1"
        },
        {
          "api": "indexing",
          "version": "v3"
        }
      ],
      "scopePolicy": {
        "optional": {
          "indexing": [
            "indexing"
          ]
        }
      },
      "toolsets": {
        "google": [
          "sc_sites_list",
          "sc_site_get",
          "sc_search_analytics_query",
          "sc_url_inspect",
          "sc_sitemaps_list",
          "sc_sitemap_get",
          "sc_sitemap_submit",
          "indexing_url_notifications_get_metadata",
          "indexing_url_notifications_publish"
        ]
      },
      "scopes": [
        "https://www.googleapis.com/auth/webmasters",
        "https://www.googleapis.com/auth/webmasters.readonly"
      ],
      "label": "Search Console: Search Console sites, sitemaps, search analytics, URL indexing and site verification."
    }
  ],
  "groupScopes": {
    "searchconsole": [
      "https://www.googleapis.com/auth/indexing",
      "https://www.googleapis.com/auth/siteverification",
      "https://www.googleapis.com/auth/siteverification.verify_only",
      "https://www.googleapis.com/auth/webmasters",
      "https://www.googleapis.com/auth/webmasters.readonly"
    ]
  }
}
