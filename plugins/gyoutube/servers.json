{
  "$comment": "Generated by scripts/bundle.mjs for the gyoutube plugin. Do not edit.",
  "plugins": {
    "gyoutube": "YouTube Data, YouTube Analytics and YouTube Reporting APIs, plus Blogger."
  },
  "groups": {
    "business": "OAuth user token with the scopes of the business APIs"
  },
  "servers": [
    {
      "name": "gyoutube",
      "plugin": "gyoutube",
      "group": "business",
      "kind": "discovery",
      "curated": null,
      "apis": [
        {
          "api": "youtube",
          "version": "v3"
        },
        {
          "api": "youtubeAnalytics",
          "version": "v2"
        },
        {
          "api": "youtubereporting",
          "version": "v1"
        },
        {
          "api": "blogger",
          "version": "v3"
        }
      ],
      "scopePolicy": {
        "optional": {
          "monetary": [
            "https://www.googleapis.com/auth/yt-analytics-monetary.readonly"
          ]
        }
      },
      "pageSizeDefaults": {
        "youtube": {
          "source": "Discovery, youtube v3: liveChatMessages.list maxResults, default 500, maximum 2000",
          "reason": "Google's default page is far over the 25,000-character result limit. Sizes are estimates from Google's resource schemas, not measured on live data.",
          "methods": {
            "youtube.liveChatMessages.list": {
              "parameter": "maxResults",
              "value": 25,
              "googleDefault": 500,
              "reason": "A chat message with its author details is about 0.6 to 1 KB; 500 are 12 to 20 times the limit."
            }
          }
        }
      },
      "toolsets": {
        "google": [
          "youtube_search_list",
          "youtube_channels_list",
          "youtube_videos_list",
          "youtube_playlists_list",
          "youtube_playlist_items_list",
          "youtube_comment_threads_list",
          "youtube_captions_list",
          "ytanalyt_reports_query",
          "youtube_videos_update",
          "youtube_comments_insert"
        ]
      },
      "label": "YouTube and Blogger: YouTube Data, YouTube Analytics and YouTube Reporting APIs, plus Blogger."
    }
  ],
  "groupScopes": {
