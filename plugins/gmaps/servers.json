      "fieldMaskDefaults": {
        "places": {
          "source": "https://developers.google.com/maps/documentation/places/web-service/text-search (also nearby-search and place-details)",
          "reason": "Google: \"If you omit the field mask, the method returns an error.\" There is no default list of fields. These defaults ask only for fields of the Essentials, IDs Only and Pro SKUs, plus nextPageToken for text search paging; Enterprise fields (rating, phone numbers, opening hours, website, price level) cost more and are asked for by name in field_mask.",
          "methods": {
            "places.places.searchText": "places.id,places.displayName,places.formattedAddress,places.location,places.types,places.googleMapsUri,nextPageToken",
            "places.places.searchNearby": "places.id,places.displayName,places.formattedAddress,places.location,places.types,places.googleMapsUri",
            "places.places.get": "id,displayName,formattedAddress,location,types,googleMapsUri"
          }
        }
      },
      "methodNotes": {
        "streetviewpublish": {
          "source": "https://developers.google.com/streetview/publish/first-app (\"After you have your API key and access token\"; the samples send both ?key=YOUR_API_KEY and authorization: Bearer YOUR_ACCESS_TOKEN). Every method of the API lists the OAuth scope https://www.googleapis.com/auth/streetviewpublish in Discovery.",
          "reason": "gmaps keeps its API key, and the approved Street View Publish credential route adds a user OAuth bearer token to these methods only, after sign-in with the streetviewpublish scope. Before sign-in the 14 tools are hidden. gsearch and every non-Street View gmaps method stay key-only (OD13a).",
          "methods": {
            "streetviewpublish.photo.create": "Street View Publish needs both this product's API key and a Google OAuth 2.0 access token with the streetviewpublish scope. Call auth_login for the Street View credential route first; until the scope is granted this tool is hidden. photo.startUpload only opens an upload session; uploading bytes is not implemented.",
            "streetviewpublish.photo.delete": "Street View Publish needs both this product's API key and a Google OAuth 2.0 access token with the streetviewpublish scope. Call auth_login for the Street View credential route first; until the scope is granted this tool is hidden. photo.startUpload only opens an upload session; uploading bytes is not implemented.",
            "streetviewpublish.photo.get": "Street View Publish needs both this product's API key and a Google OAuth 2.0 access token with the streetviewpublish scope. Call auth_login for the Street View credential route first; until the scope is granted this tool is hidden. photo.startUpload only opens an upload session; uploading bytes is not implemented.",
