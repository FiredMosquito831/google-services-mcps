{
  "$comment": "Generated by scripts/bundle.mjs for the gmail plugin. Do not edit.",
  "plugins": {
    "gmail": "Gmail mailboxes, messages, labels and settings, plus Gmail Postmaster Tools."
  },
  "groups": {
    "workspace-user": "OAuth user token for Gmail, Drive, Calendar and the other personal Workspace APIs"
  },
  "servers": [
    {
      "name": "gmail",
      "plugin": "gmail",
      "group": "workspace-user",
      "kind": "curated+discovery",
      "curated": "src/servers/gmail.ts",
      "apis": [
        {
          "api": "gmail",
          "version": "v1"
        },
        {
          "api": "gmailpostmastertools",
          "version": "v2"
        }
      ],
      "gatewayApis": [
        {
          "api": "gmailpostmastertools",
          "version": "v1"
        },
        {
          "api": "gmailpostmastertools",
          "version": "v1beta1"
        }
      ],
      "scopes": [
        "https://mail.google.com/",
        "https://www.googleapis.com/auth/gmail.compose",
        "https://www.googleapis.com/auth/gmail.labels",
        "https://www.googleapis.com/auth/gmail.metadata",
        "https://www.googleapis.com/auth/gmail.modify",
        "https://www.googleapis.com/auth/gmail.readonly"
      ],
      "label": "Gmail: Gmail mailboxes, messages, labels and settings, plus Gmail Postmaster Tools."
    }
  ]
}
