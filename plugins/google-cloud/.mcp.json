{
  "mcpServers": {
    "gcloud": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/servers/gcloud.mjs"
      ],
      "env": {
        "GSM_ALLOW_WRITES": "${user_config.allow_writes}",
        "GSM_TOKEN_DIR": "${user_config.token_dir}"
      }
    },
    "gcloud-ops": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/servers/gcloud-ops.mjs"
      ],
      "env": {
        "GSM_ALLOW_WRITES": "${user_config.allow_writes}",
        "GSM_TOKEN_DIR": "${user_config.token_dir}"
      }
    },
    "gcloud-data": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/servers/gcloud-data.mjs"
      ],
      "env": {
        "GSM_ALLOW_WRITES": "${user_config.allow_writes}",
        "GSM_TOKEN_DIR": "${user_config.token_dir}"
      }
    },
    "gcloud-compute": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/servers/gcloud-compute.mjs"
      ],
      "env": {
        "GSM_ALLOW_WRITES": "${user_config.allow_writes}",
        "GSM_TOKEN_DIR": "${user_config.token_dir}"
      }
    }
  }
}
