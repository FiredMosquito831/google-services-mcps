# Reference clones (other people's code, read-only analysis)
reference/
# Session transcript copy and remember-plugin state (may contain private chat content)
session/
.remember/
# Build and dependency output
node_modules/
dist/
# Generated server entries (scripts/bundle.mjs writes build/entries/<server>.ts)
build/
# Credentials and tokens must never be committed
*.token.json
client_secret*.json
*.key.json
service-account*.json
.env
.env.*
# Logs and OS junk
*.log
.DS_Store
Thumbs.db

# Handoff note from the planning session (not part of the product)
HANDOFF.md


# Raw Google Discovery cache written by scripts/build-catalog.mjs (re-downloadable)
data/cache-discovery/

# crash dumps from msys bash on Windows
*.stackdump
